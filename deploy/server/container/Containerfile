# P2: DSH Web 容器镜像（Debian 13 trixie，预编译 GCC 14）
# 构建：podman build -t dsh-web-p2:latest deploy/server/container/
FROM docker.io/library/node:24-trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    bubblewrap ca-certificates git curl jq unzip zip ripgrep python3 python3-pip python3-venv \
    gcc g++ make libc6-dev \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /workspace && chown node:node /workspace

# GitHub CLI：官方 Releases 预编译二进制
ARG GH_VERSION=2.106.0
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" -o /tmp/gh.tar.gz \
 && tar -xzf /tmp/gh.tar.gz -C /tmp \
 && install -m 755 "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
 && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_amd64" \
 && gh --version

USER node
WORKDIR /app
ENV HOME=/home/node
EXPOSE 3080
